  "policy": {
    "heading": "Our Commission Policy",
    "cards": [
      {
        "title": "Recommendations Based on Suitability",
        "body": "All fund recommendations are based strictly on your risk profile, financial goals, and investment horizon — never on commission rates received from AMCs."
      },
      {
        "title": "No Hidden Charges",
        "body": "There are no hidden charges, transaction fees, or advisory fees charged to you beyond what is disclosed on this page. What you see is what you get."
      },
      {
        "title": "No Non-Cash Benefits",
        "body": "We do not receive any non-cash benefits, gifts, sponsored trips, or incentives from any AMC that could create a conflict of interest in our recommendations."
      },
      {
        "title": "CAS Transparency",
        "body": "The exact commission earned by Innovate Securities on your investments is visible in your Consolidated Account Statement (CAS) from CAMS, KFintech, or MF Central."
      },
      {
        "title": "Direct Plan Option",
        "body": "Direct Plans are available at lower expense ratios through AMC portals. Innovate Securities does not facilitate Direct Plan investments; you may invest in Direct Plans independently if you prefer."
      },
      {
        "title": "Quarterly Updates",
        "body": "This commission disclosure is reviewed and updated periodically to reflect current trail commission practices and regulatory requirements."
      }
    ]
  },
  "prohibited": {
    "heading": "Practices We Strictly Prohibit",
    "items": [
      "Recommending schemes based on higher commission rates instead of investor suitability",
      "Accepting upfront commissions or any form of commission that is not trail-based",
      "Receiving non-cash benefits, gifts, or incentives from any AMC",
      "Splitting investor applications to earn higher transaction charges",
      "Concealing commission information from investors when asked"
    ]
  },
